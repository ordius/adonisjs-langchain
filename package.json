{
  "name": "@ordius/adonisjs-langchain",
  "version": "0.1.1",
  "description": "AdonisJS provider for LangChain with multi-LLM support",
  "engines": {
    "node": ">=24"
  },
  "main": "build/index.js",
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types/index.js",
    "./services/main": "./build/services/main.js",
    "./services/llm": "./build/services/main.js",
    "./langchain_manager": "./build/src/langchain_manager.js",
    "./provider": "./build/providers/langchain_provider.js"
  },
  "scripts": {
    "clean": "del-cli build",
    "copy:templates": "copyfiles \"stubs/**/*.stub\" build",
    "typecheck": "tsc --noEmit && tsc --noEmit --noUnusedLocals false --project tsconfig.typecheck.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "quick:test": "tsx bin/test.ts",
    "pretest": "npm run lint",
    "test": "npm run quick:test",
    "prebuild": "npm run lint && npm run clean",
    "build": "tsc",
    "postbuild": "npm run copy:templates",
    "release": "release-it",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "release:beta": "release-it --preRelease=beta",
    "release:alpha": "release-it --preRelease=alpha",
    "release:next": "release-it --preRelease=next --npm.tag=next",
    "release:dry": "release-it --dry-run",
    "version": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "adonisjs",
    "langchain",
    "llm",
    "ai",
    "openai",
    "anthropic",
    "provider"
  ],
  "author": "Mixxtor",
  "license": "MIT",
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/core": "^7.3.4",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.3.0",
    "@langchain/core": "^1.2.1",
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/node": "^26.1.0",
    "copyfiles": "^2.4.1",
    "del-cli": "^7.0.0",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "release-it": "^20.2.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.0",
    "@langchain/core": "^1.2.1"
  },
  "homepage": "https://github.com/ordius/adonisjs-langchain#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ordius/adonisjs-langchain.git"
  },
  "bugs": {
    "url": "https://github.com/ordius/adonisjs-langchain/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true,
      "releaseName": "Release v${version}",
      "releaseNotes": null,
      "autoGenerate": true,
      "draft": false,
      "preRelease": false
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": "@adonisjs/prettier-config"
}
